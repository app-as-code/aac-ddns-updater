# Copy to .env and set every CHANGE_ME:  cp .env.example .env

# SECRET - set a strong value
DDNS_API_KEY=CHANGE_ME

# REQUIRED - set for your environment
DDNS_DOMAIN=CHANGE_ME

# REQUIRED - set for your environment
DDNS_HOST=CHANGE_ME

# REQUIRED - set for your environment
RESOLVER_ADDRESS=CHANGE_ME

# default: 
DDNS_IPV6_SUFFIX=

# default: ipv4
DDNS_IP_VERSION=ipv4

# default: ionos
DDNS_PROVIDER=ionos
